# Runtime mode. Vercel sets NODE_ENV automatically; keep this empty locally unless needed.
NODE_ENV=

# Public browser-safe values. These are exposed to client-side code.
NEXT_PUBLIC_APP_NAME=HomeOrder
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Data source selection.
# Current app defaults to the mock repository unless DATA_SOURCE=google_sheets.
# Google Sheets repository is currently a reserved stub and should be completed before production data use.
DATA_SOURCE=mock

# Google Sheets integration placeholders.
# Leave empty until Google Sheets API is implemented and enabled.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# In Vercel, paste the private key with escaped newlines, for example:
# -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Auth placeholders.
# Leave empty until NextAuth or another auth layer is implemented.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
